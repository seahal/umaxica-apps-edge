---
/*
 * The content surface this unit serves: the page's single `<h1>`, the site it
 * belongs to, and its body copy. Ported from `src/components/page-hero.tsx`.
 *
 * `id="main-content"` is the skip link's target (ui-shell-contract §12);
 * `tabindex="-1"` makes that link move focus rather than only scroll.
 *
 * Paragraphs arrive as strings, not slotted markup, so a caller cannot put a
 * heading, a second `<main>` or an interactive control inside the hero.
 */
interface Props {
  siteName: string;
  title: string;
  paragraphs: string[];
}
const { siteName, title, paragraphs } = Astro.props;
---
<main class="flex-1 py-12" id="main-content" tabindex="-1">
  <div class="mx-auto flex w-full max-w-7xl flex-col gap-8 px-4 wide:px-8">
    <div class="flex flex-col gap-3">
      <h1
        class="max-w-prose text-4xl leading-heading font-bold tracking-tight wide:text-5xl"
      >
        {title}
      </h1>
      <p class="text-sm text-gray-600">{siteName}</p>
    </div>
    <div class="flex flex-col gap-4">
      {paragraphs.map((paragraph) => <p class="max-w-prose text-lg">{paragraph}</p>)}
    </div>
  </div>
</main>
