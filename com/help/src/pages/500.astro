---
/*
 * Astro's server-error document. Not a content URL: visiting `/500` while the
 * Worker is healthy is still a 404. This file is what a thrown on-demand route
 * renders, with HTTP 500.
 *
 * No home link — if this origin is erroring, `/ja/` is likely erroring too.
 * Reload retries the request that failed.
 */
import StatusSplash from '../layouts/StatusSplash.astro';
---
<StatusSplash kind="serverError" />
