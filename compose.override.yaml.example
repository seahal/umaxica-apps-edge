# 開発者ローカル / ホスト固有の任意 override の「例」です。
#
#   compose.yaml                  = 共有サービス (トンネル、各ユニットの app プロファイル)
#   .devcontainer/compose.yaml    = `core` (ワークスペースコンテナ)
#                                   この 2 本で標準開発環境が成立する。
#   compose.override.yaml         = 任意のローカル override (Git 追跡外)
#   compose.override.yaml.example = このファイル。追跡されるドキュメント。
#
# このファイルをコピーしなくても開発環境は起動します。必要な人だけ
#
#   cp compose.override.yaml.example compose.override.yaml
#
# として自分のマシンに合わせて編集してください。読み込むのは
# `scripts/dev-start` です。`compose.yaml` と `.devcontainer/compose.yaml` に
# 続けて、存在すれば `-f compose.override.yaml` を渡します。
#
# 注意 1: このファイルが上書きする `core` は `.devcontainer/compose.yaml` にしか
# 定義されていません。`-f` を付けない素の `docker compose` / `podman compose` も
# compose.override.yaml を自動で読み込みますが、そのとき読むのは `compose.yaml`
# だけなので、`core` がイメージもビルドも持たないサービスになり失敗します。
# `core` を扱うときは `scripts/dev-start` を使ってください。
#
# 注意 2: `.devcontainer/devcontainer.json` は `dockerComposeFile` で
# `../compose.yaml` と `./compose.yaml` の 2 本を明示指定します。Dev Containers は
# 指定されたファイルを `-f` で渡すため、Compose の override 自動探索はそこでは
# 働かず、このファイルは読み込まれません。override を効かせたい場合は
# `scripts/dev-start` で起動してください。
#
# ここに秘密情報を書かないでください。値は必ずホストの環境変数を
# `${VAR}` で参照する形にします。秘密鍵をマウントしてはいけません。

# `compose.yaml` の `name:` と必ず一致させること。Compose はプロジェクト名を
# 「最後に name: を設定したファイル」から取るため、違う値を書くとプロジェクトが
# 分裂し、コンテナと volume の組がもう 1 セット出来てしまう。
name: umaxica-apps-edge

services:
  core:
    # `volumes` はリストだが、下の bind は compose.yaml が持たない target なので、
    # target でマージする Compose でも単純追記する podman-compose でも結果は同じ。
    volumes:
      # ホストの known_hosts (公開情報のみ) を read_only で 1 ファイルだけ。
      # `.ssh` ディレクトリ全体や id_ed25519 等の秘密鍵は絶対にマウントしない
      # (test/development-container-security.test.ts がその 2 つを拒否する)。
      #
      # 標準構成に置けない理由: ホスト側に ~/.ssh/known_hosts が通常ファイルとして
      # 存在しない場合、Podman はそのパスを「ディレクトリ」として作ってしまう。
      # つまり fresh clone のマシンでは壊れる。だからここに置いている。
      # :z / :Z は付けない。付ければホスト側 ~/.ssh を再ラベルしてしまう
      # (compose.yaml の label=disable がこのコンテナに閉じて効いている)。
      - type: bind
        source: ${HOME}/.ssh/known_hosts
        target: /home/edge/.ssh/known_hosts
        read_only: true

      # ssh-agent socket の転送。秘密鍵そのものではなく socket だけを渡すこと。
      # ソケットのパスはマシンごとに違い、古い値だとコンテナ起動前に bind が
      # 失敗する (no such file or directory) ため、標準構成に
      # は置けない。Git over SSH を使う人だけコメントを外す。
      # - type: bind
      #   source: ${SSH_AUTH_SOCK}
      #   target: /ssh-agent

    # ssh-agent socket を上で有効にしたときだけ必要。
    # environment:
    #   SSH_AUTH_SOCK: /ssh-agent

    # マシン固有の追加ポート。`ports` はリストで、Compose は base と連結する
    # ため、compose.yaml が既に公開しているポートを再掲しないこと。
    # 公開先は必ず 127.0.0.1 に限定する。
    # ports:
    #   - '127.0.0.1:9229:9229' # node --inspect

    # security_opt はリストで、Compose は override 側の要素を base に「追記」
    # する。compose.yaml の `no-new-privileges:true` / `label=disable` を再掲
    # すると `services.core.security_opt items at 0 and 1 are equal` で
    # Compose v2.24+ が弾くので、絶対に書き足さないこと。`!override` タグは
    # podman-compose 1.5.0 が解釈できない
    # (`TypeError: 'OverrideTag' object is not iterable`) ので使えない。

# 実験用サービスを足す場合もここに。標準構成に混ぜないこと。
# services:
#   my-experiment:
#     image: docker.io/library/alpine:3.20
