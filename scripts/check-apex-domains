#!/usr/bin/env bash
set -euo pipefail

# Asserts each Edge-owned production apex hostname is served by ITS OWN Worker.
#
# Only umaxica.net remains: the app/com/org apex Workers were retired by
# adr/024-retire-app-com-org-apex-units.md and those hostnames are no longer
# Edge-owned. umaxica.dev is not a production Worker.
#
# A plain 200 check cannot catch this class of failure: when umaxica.net was
# bound to the (now retired) app/apex Worker it answered every request successfully, just
# from the wrong Worker. The `service` field in /health.json is set from the
# `createApexApp(..., { service })` argument, so it identifies which Worker
# actually handled the request.

checks=(
  'umaxica.net|net'
)

failed=0
for check in "${checks[@]}"; do
  host=${check%%|*}
  want=${check#*|}
  got=$(curl --fail --silent --show-error --max-time 10 "https://${host}/health.json" \
    | sed -n 's/.*"service":"\([^"]*\)".*/\1/p') || got=''
  if [[ "${got}" == "${want}" ]]; then
    echo "PASS ${host} served by ${got}/apex"
  else
    echo "FAIL ${host} served by ${got:-<unreachable>}/apex (want ${want}/apex)" >&2
    failed=1
  fi
done
exit "${failed}"
