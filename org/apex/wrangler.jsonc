{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "umaxica-apps-edge-org-apex",
  "keep_vars": true,
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_als"],
  "main": "./src/index.tsx",
  // No `directory`: this is the INPUT config, and `vite build` writes an output
  // wrangler.json whose `assets.directory` points at the client build. Setting
  // it here would describe a directory that the deployed Worker never uses.
  //
  // Both handling modes are "none" on purpose, and they are the guard that
  // keeps `/` reachable. Cloudflare matches assets BEFORE the Worker runs, so
  // any HTML asset can take a route away from Hono without failing anything.
  // This unit ships no HTML assets at all, so "none" costs nothing and means a
  // stray index.html could not silently answer `/` in place of the homepage
  // route. `run_worker_first` is deliberately NOT set: it would invoke the
  // Worker for every asset request, turning free static-asset serving into
  // billed invocations, and it is not needed to reach the Worker here.
  "assets": { "html_handling": "none", "not_found_handling": "none" },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  // Keep the production Worker reachable without reclaiming the apex custom
  // domain from the development Tunnel.
  "workers_dev": true,
  "preview_urls": true,
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    // Query strings carry `lx`, `lang`, search terms and OIDC parameters; none of
    // them belongs in a log line or a span.
    "redact_query_string": true,
    "issues": {
      "enabled": true
    },
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    // Logs are complete; traces are sampled at 20%. Identical in all seventeen
    // units so the numbers are comparable — tools/check-workers.mjs enforces it.
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.2,
      "persist": true
    }
  },
  // The top level IS production; there is no `env.production`. Deploy scripts blank
  // CLOUDFLARE_ENV so a no-`--env` deploy stays production; the tier reaches the
  // Worker as EDGE_ENV only. tools/check-workers.mjs enforces both.
  "vars": {
    "EDGE_ENV": "production",
    "BRAND_NAME": "UMAXICA"
  },
  // Empty on purpose: the apex hostname is owned by the development Tunnel, which
  // cannot share it with a custom domain — see adr/008-edge-development-tunnel-exposure.md.
  // Named environments inherit this key, so they pin `"routes": []` too.
  "routes": [],

  "env": {
    "development": {
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "vars": {
        "EDGE_ENV": "development",
        "BRAND_NAME": "UMAXICA"
      },
      // Required: `routes` IS inherited, so without this an `--env development`
      // deploy would reassign the production custom domain.
      "routes": [],
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "2530100",
          "simple": {
            "limit": 2000,
            "period": 60
          }
        }
      ]
    },
    // `test` is never deployed — it only resolves test-tier config for
    // `wrangler dev --env test`. Only non-inheritable keys are repeated here.
    "test": {
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "vars": {
        "EDGE_ENV": "test",
        "BRAND_NAME": "UMAXICA"
      },
      // See the note in `env.development` — blocks route inheritance.
      "routes": [],
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "3530100",
          "simple": {
            "limit": 2000,
            "period": 60
          }
        }
      ]
    }
  },
  "placement": { "mode": "smart" },
  // https://developers.cloudflare.com/workers/runtime-apis/bindings/rate-limit/
  //
  // The namespace_id is SHARED, on purpose, with every other unit of this brand
  // at this tier. Counters are per (namespace_id, key) and are account-wide —
  // "even across different Workers on the same account" — so all six Workers of
  // this brand count one budget per client IP.
  //
  // That is the point. A per-unit namespace would hand any client six separate
  // budgets reachable by rotating subdomains, which is a bypass no limit value
  // can close. Sharing costs little in return: the key is the client IP, so a
  // merged budget bounds one client's own total rather than letting strangers
  // exhaust each other's.
  //
  // CONSEQUENCE: every binding on this namespace_id must declare the SAME limit
  // and period. Cloudflare does not define what happens when two bindings
  // disagree, and the strictest one would fire against the combined count —
  // making this Worker's effective limit depend on other units' traffic.
  // tools/check-workers.mjs enforces the agreement repository-wide.
  //
  // 2000/60 is a starting point to tune against real traffic, not a measured
  // figure. Note limits are enforced per Cloudflare location, so the effective
  // ceiling is this value times the number of locations a client reaches.
  // See adr/010-first-touch-rate-limiting.md.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "530100",
      "simple": {
        "limit": 2000,
        "period": 60
      }
    }
  ]
}
