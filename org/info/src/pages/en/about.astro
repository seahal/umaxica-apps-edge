---
/*
 * The info frame's "about this site" page. Copy (ja + en) lives here, as it did
 * in `src/routes/about.tsx`.
 */
import PageHero from '../../components/PageHero.astro';
import Base from '../../layouts/Base.astro';
import { type Locale, type PageCopy } from '../../i18n';
import { brandTitle } from '../../lib/title';

const COPY: Record<Locale, PageCopy> = {
  ja: {
    siteName: 'UMAXICA インフォメーション',
    title: 'このサイトについて',
    heading: 'このサイトについて',
    description: 'Information about the UMAXICA platform.',
    paragraphs: [
      'このサイトでは、UMAXICA のサービスに関するご案内を掲載しています。提供中のサービス内容、利用条件、各種お手続きについてご確認いただけます。',
      '掲載内容は予告なく変更される場合があります。',
    ],
  },
  en: {
    siteName: 'UMAXICA Information',
    title: 'About this site',
    heading: 'About this site',
    description: 'Information about the UMAXICA platform.',
    paragraphs: [
      'This site publishes information about the services UMAXICA offers. You can review the services currently offered, their conditions of use, and the procedures related to them.',
      'The content may change without notice.',
    ],
  },
};

const lang = 'en' satisfies Locale;
const copy = COPY[lang];
---
<Base locale={lang} title={brandTitle(copy.title)} description={copy.description} pagePath="/about">
  <PageHero siteName={copy.siteName} title={copy.heading} paragraphs={copy.paragraphs} />
</Base>
