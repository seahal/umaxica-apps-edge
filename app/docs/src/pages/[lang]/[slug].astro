---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import { getEdgeBindings } from '../../lib/env';
import { isLocale } from '../../i18n';
import { brandTitle } from '../../lib/title';
import { cmsStatus, type CmsFetchResult } from '../../lib/cms/document';
import { documentFetchLogEntry, logDocumentFetch } from '../../lib/cms/document-fetch-log';
import { resolveCmsClient } from '../../lib/cms/runtime';

const NO_STORE = 'no-store';
const started = performance.now();
const lang = Astro.params.lang;
const slug = Astro.params.slug;
let result: CmsFetchResult;
if (!isLocale(lang) || !slug) {
  result = { kind: 'not-found', upstreamStatus: 404 };
} else {
  try {
    const resolved = resolveCmsClient(getEdgeBindings());
    result = 'fetchDocument' in resolved ? await resolved.fetchDocument(lang, slug) : resolved;
  } catch {
    result = { kind: 'internal-error' };
  }
}
logDocumentFetch(documentFetchLogEntry(result, performance.now() - started));
Astro.response.headers.set('Cache-Control', NO_STORE);
if (result.kind !== 'ok') {
  const status = cmsStatus(result);
  const heading = status === 404 ? 'Page not found' : 'Unable to display this page';
  return new Response(`<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="robots" content="noindex,nofollow"><title>${heading}</title></head><body><main><h1>${heading}</h1><p>HTTP ${status}</p></main></body></html>`, { status, headers: { 'Content-Type': 'text/html; charset=utf-8', 'Cache-Control': NO_STORE, 'X-Robots-Tag': 'noindex, nofollow' } });
}
const document = result.document;
---
<Base locale={lang} title={brandTitle(document.title)} description={document.summary ?? document.title} pagePath={`/${slug}`} alternateLocales={[lang]}>
  <main class="mx-auto grid w-full max-w-4xl flex-1 gap-6 px-6 py-12" id="main-content" tabindex="-1">
    <article class="grid gap-6">
      <h1 class="text-3xl leading-heading font-semibold">{document.title}</h1>
      {document.summary && <p class="text-lg text-gray-700">{document.summary}</p>}
      <p class="whitespace-pre-wrap">{document.body.text}</p>
    </article>
  </main>
</Base>
