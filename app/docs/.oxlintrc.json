{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // The plugin list is exhaustive on purpose: a plugin is enabled because this
  // unit's stack needs it, not because oxlint ships it. A framework plugin for a
  // framework this unit does not run reports on ordinary code — an `<a>` in a
  // failure document is not a bug — so it stays off.
  "plugins": ["typescript", "import", "promise", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error"
  },
  "env": {
    "browser": true,
    "es2024": true,
    "node": true
  },
  "globals": {
    "afterEach": "readonly",
    "beforeEach": "readonly",
    "describe": "readonly",
    "expect": "readonly",
    "it": "readonly",
    "vi": "readonly"
  },
  "rules": {
    "no-unused-vars": "error",
    "no-console": "error",
    "no-var": "error",
    "prefer-const": "error",
    "eqeqeq": "error",
    "no-eval": "error",
    "no-implied-eval": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-imports": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/shared/**", "**/shared/*"],
            "message": "shared/ has been removed. Each frame owns its own components, types, hooks, and utilities — copy the implementation into this frame instead of reintroducing a shared module. (Cross-unit imports are a separate invariant, owned by test/deployment-unit-boundaries.test.ts — this rule only stops a shared/ directory coming back.)"
          },
          {
            "group": [
              "react-aria",
              "react-aria/*",
              "react-stately",
              "react-stately/*",
              "@react-aria/*",
              "@react-stately/*",
              "@react-types/*",
              "@internationalized/*"
            ],
            "message": "Import from `react-aria-components` only. These packages are its internals — `react-aria-components` pulls `react-aria` 3.51.0 and `react-stately` 3.49.0 in itself and imports them at ~790 sites — and this unit declares none of them, so a direct import also depends on a package its package.json does not list. If a react-aria-components API genuinely requires one of these as a value type (@internationalized/date for the date components is the known case), that is a decision to record in docs/design/ui-shell-contract.md §3a, not to work around here."
          }
        ]
      }
    ],
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/use-unknown-in-catch-callback-variable": "error",
    "typescript/non-nullable-type-assertion-style": "error",
    "import/no-unassigned-import": "off",
    "vitest/require-mock-type-parameters": "off",
    "vitest/no-conditional-in-test": "off",
    "vitest/no-conditional-expect": "off",
    "vitest/valid-expect": "off",
    "vitest/valid-title": "off",
    "vitest/expect-expect": [
      "error",
      {
        "assertFunctionNames": [
          "expect",
          "expectTypeOf",
          "assert",
          "assertType",
          "expectTitleContract",
          "expectFailClosed"
        ]
      }
    ],
    "eslint/max-lines": "off",
    "eslint/max-lines-per-function": "off",
    "eslint/max-classes-per-file": "off",
    "eslint/max-nested-callbacks": "off",
    "eslint/no-inline-comments": "off",
    "eslint/no-warning-comments": "off",
    "eslint/no-await-in-loop": "off",
    "eslint/require-await": "off",
    "eslint/prefer-promise-reject-errors": "off",
    "promise/no-promise-in-callback": "off",
    "import/max-dependencies": "off",
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/strict-boolean-expressions": "off",
    "typescript/prefer-nullish-coalescing": "off",
    "typescript/no-confusing-void-expression": "off",
    "typescript/strict-void-return": "off",
    "typescript/require-await": "off",
    "typescript/prefer-promise-reject-errors": "off",
    "typescript/consistent-return": "off",
    "import/no-cycle": "error",
    "import/no-self-import": "error"
  },
  "overrides": [
    {
      // Astro pilot verification scripts (plan Phase 1). Plain Node CLI scripts:
      // they print to stdout and match patterns in built HTML, so `no-console`
      // and `require-unicode-regexp` do not apply the way they do to unit code.
      "files": ["test-astro/**"],
      "rules": {
        "no-console": "off",
        "eslint/no-negated-condition": "off",
        "eslint/require-unicode-regexp": "off",
        "typescript/prefer-includes": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off"
      }
    },
    {
      "files": ["test/**", "**/*.test.ts", "**/*.test.tsx", "e2e/**", "**/__mocks__/**"],
      "rules": {
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-unnecessary-condition": "off",
        "typescript/no-unnecessary-type-assertion": "off",
        "typescript/non-nullable-type-assertion-style": "off"
      }
    },
    {
      "files": ["tools/**", "scripts/**", "public/**", "*.mjs", "*.cjs"],
      "rules": {
        "typescript/no-floating-promises": "off",
        "typescript/no-misused-promises": "off",
        "typescript/await-thenable": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-unnecessary-condition": "off",
        "typescript/restrict-template-expressions": "off",
        "typescript/use-unknown-in-catch-callback-variable": "off",
        "typescript/non-nullable-type-assertion-style": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/.wrangler/**",
    "**/dist/**",
    "**/node_modules/**",
    "worker-configuration.d.ts",
    "**/.astro/**",
    "**/+types/**",
    "**/build/**"
  ]
}
