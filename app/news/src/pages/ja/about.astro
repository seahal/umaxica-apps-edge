---
/*
 * The news frame's "about this site" page. Copy (ja + en) lives here, as it did
 * in `src/routes/about.tsx`.
 */
import PageHero from '../../components/PageHero.astro';
import Base from '../../layouts/Base.astro';
import { type Locale, type PageCopy } from '../../i18n';
import { brandTitle } from '../../lib/title';

const COPY: Record<Locale, PageCopy> = {
  ja: {
    siteName: 'UMAXICA ニュース',
    title: 'このサイトについて',
    heading: 'このサイトについて',
    description: 'News and announcements from UMAXICA.',
    paragraphs: [
      'このサイトでは、UMAXICA からの最新のお知らせをお届けしています。新機能のリリース、メンテナンスの予定、障害発生時のご報告などを掲載しています。',
      '重要なお知らせは順次このページに追加されます。',
    ],
  },
  en: {
    siteName: 'UMAXICA News',
    title: 'About this site',
    heading: 'About this site',
    description: 'News and announcements from UMAXICA.',
    paragraphs: [
      'This site delivers the latest announcements from UMAXICA — feature releases, scheduled maintenance windows, and incident reports.',
      'Important announcements are added to this page as they arise.',
    ],
  },
};

const lang = 'ja' satisfies Locale;
const copy = COPY[lang];
---
<Base locale={lang} title={brandTitle(copy.title)} description={copy.description} pagePath="/about">
  <PageHero siteName={copy.siteName} title={copy.heading} paragraphs={copy.paragraphs} />
</Base>
