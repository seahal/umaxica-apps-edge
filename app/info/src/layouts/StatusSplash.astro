---
/*
 * Chrome-free splash. Offline: reload (the only recovery; the cache has this
 * document only). HTTP 500: do not reload — a herd of retries would load the
 * failing origin. Send people to the status page on a different host.
 *
 * 404 stays in Base with a home link: the rest of this origin is fine.
 */
import '../styles/global.css';
import { brandTitle } from '../lib/title';
import { CANONICAL_ORIGIN } from '../lib/canonical';
import { SHELL } from '../i18n';

interface Props {
  kind: 'offline' | 'serverError';
}

/** Incident board, not this origin — so a down Worker does not also 500 the link. */
const STATUS_PAGE_HREF = 'https://status.umaxica.dev/';

const { kind } = Astro.props;
const t = kind === 'offline' ? SHELL.ja.offline : SHELL.ja.serverError;
const title = brandTitle(t.title);
const path = kind === 'offline' ? '/offline' : '/500';
const canonical = new URL(path, CANONICAL_ORIGIN).href;
const isOffline = kind === 'offline';
---
<!doctype html>
<html lang="ja" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={t.body} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body class="grid min-h-screen place-content-center bg-gray-50 p-6 text-center leading-body text-gray-900">
    <main class="grid max-w-md gap-4" id="main-content" tabindex="-1">
      <p class="text-sm tracking-wide text-gray-500">{SHELL.ja.brand}</p>
      <h1 class="text-2xl leading-heading font-semibold">{t.heading}</h1>
      {'status' in t && <p class="text-gray-500">{t.status}</p>}
      <p class="text-gray-700">{t.body}</p>
      {
        isOffline ? (
          <button
            class="inline-flex min-h-11 items-center justify-self-center rounded-full border border-gray-300 bg-white px-4 py-2 hover:bg-gray-100"
            id="status-reload"
            type="button"
          >
            {SHELL.ja.offline.reload}
          </button>
        ) : (
          <a
            class="inline-flex min-h-11 items-center justify-self-center rounded-full border border-gray-300 bg-white px-4 py-2 hover:bg-gray-100"
            href={STATUS_PAGE_HREF}
            rel="noreferrer"
          >
            {SHELL.ja.serverError.statusPage}
          </a>
        )
      }
    </main>
    {isOffline && <script is:inline src="/status-reload.js" defer></script>}
  </body>
</html>
